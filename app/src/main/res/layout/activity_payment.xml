<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:baselineAligned="false"
    android:orientation="horizontal"
    android:padding="12dp">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.2">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_panel_accent"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:contentDescription="@string/app_name"
                    android:src="@drawable/ic_launcher_fg" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="SHADOW DUEL · NẠP GEMS"
                    android:textColor="@color/accent_yellow"
                    android:textStyle="bold|italic" />

                <TextView
                    android:id="@+id/payTimer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/accent_red"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/payTitle"
                style="@style/Text.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/payAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/accent_cyan"
                android:textSize="26sp"
                android:textStyle="bold|italic" />

            <TextView
                android:id="@+id/payBank"
                style="@style/Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/text_primary" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_row"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nội dung CK: "
                    android:textColor="@color/text_secondary" />

                <TextView
                    android:id="@+id/payContent"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/accent_yellow"
                    android:textIsSelectable="true"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/payCopy"
                    style="@style/Widget.ShadowDuel.Button.Outlined"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SAO CHÉP" />
            </LinearLayout>

            <TextView
                android:id="@+id/payStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_panel"
                android:gravity="center"
                android:padding="10dp"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold|italic" />

            <TextView
                style="@style/Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="1. Mở ứng dụng ngân hàng, quét mã QR.\n2. Giữ nguyên số tiền và NỘI DUNG chuyển khoản (chứa mã đơn).\n3. Hệ thống tự xác minh qua SePay và cộng Gems trong vài giây — không cần gửi ảnh hay mã OTP.\n4. Chuyển sai số tiền / sai nội dung / sau khi hết hạn: đơn được chuyển sang đối soát thủ công."
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/paySave"
                    style="@style/Widget.ShadowDuel.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="LƯU QR" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/payCheck"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="KIỂM TRA" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/payMock"
                style="@style/Widget.ShadowDuel.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="[DEV] GIẢ LẬP THANH TOÁN (MOCK)"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:background="#FFFFFFFF"
        android:padding="10dp">

        <ImageView
            android:id="@+id/payQr"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Mã QR thanh toán"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/payQrHint"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="16dp"
            android:textColor="#333333" />
    </FrameLayout>
</LinearLayout>
