<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingHorizontal="12dp"
    android:paddingTop="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/ecoBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Quay lại"
            android:rotation="180"
            android:src="@drawable/ic_chevron"
            app:tint="@color/text_primary" />

        <TextView
            android:id="@+id/ecoTitle"
            style="@style/Text.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/ecoGold"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:background="@drawable/bg_panel"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:textColor="@color/accent_yellow"
            android:textStyle="bold|italic" />

        <TextView
            android:id="@+id/ecoGems"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_panel"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:textColor="@color/accent_cyan"
            android:textStyle="bold|italic" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/ecoAction"
            style="@style/Widget.ShadowDuel.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:visibility="gone" />
    </LinearLayout>

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/ecoTabs"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="@android:color/transparent"
        app:tabIndicatorColor="@color/accent_yellow"
        app:tabMode="scrollable"
        app:tabSelectedTextColor="@color/accent_yellow"
        app:tabTextColor="@color/text_secondary" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/ecoProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true" />

    <TextView
        android:id="@+id/ecoEmpty"
        style="@style/Text.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="24dp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/ecoList"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="6dp"
        android:clipToPadding="false"
        android:layoutAnimation="@anim/list_in"
        android:paddingBottom="12dp" />
</LinearLayout>
