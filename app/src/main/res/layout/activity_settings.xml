<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_panel_accent"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                style="@style/Text.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings" />

            <TextView
                style="@style/Text.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Game server" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="ws://IP:8080 hoặc wss://domain">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/serverInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textUri" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                style="@style/Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Máy ảo Android: ws://10.0.2.2:8080 · Điện thoại thật cùng Wi-Fi: ws://IP-LAN-của-PC:8080 · Qua Internet: wss://tên-miền-server"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/testServer"
                style="@style/Widget.ShadowDuel.Button.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="KIỂM TRA KẾT NỐI" />

            <TextView
                android:id="@+id/testResult"
                style="@style/Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="Tên khi chơi khách">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/guestInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLength="16" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:background="@drawable/bg_panel"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                style="@style/Text.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/graphics" />

            <RadioGroup
                android:id="@+id/qualityGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/qLow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Thấp" />

                <RadioButton
                    android:id="@+id/qMed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Trung bình" />

                <RadioButton
                    android:id="@+id/qHigh"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cao" />
            </RadioGroup>

            <TextView
                android:id="@+id/opacityLabel"
                style="@style/Text.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp" />

            <com.google.android.material.slider.Slider
                android:id="@+id/opacitySlider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:stepSize="5"
                android:valueFrom="30"
                android:valueTo="100" />

            <TextView
                android:id="@+id/botLabel"
                style="@style/Text.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <com.google.android.material.slider.Slider
                android:id="@+id/botSlider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:stepSize="10"
                android:valueFrom="10"
                android:valueTo="100" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/vibrationSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Rung khi trúng đòn / hạ gục" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/fpsSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Hiện FPS" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/saveSettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="LƯU" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
