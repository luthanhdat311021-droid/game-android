<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:baselineAligned="false"
    android:orientation="horizontal"
    android:padding="12dp">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_panel_accent"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                style="@style/Text.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/create_room" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="Tên phòng">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/roomNameInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLength="32" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                style="@style/Text.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Chế độ" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/createModeChips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/cFfa"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Free For All" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/cTdm"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Team Deathmatch" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/cSurvival"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Survival" />
            </com.google.android.material.chip.ChipGroup>

            <TextView
                android:id="@+id/maxLabel"
                style="@style/Text.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Số người tối đa: 8" />

            <com.google.android.material.slider.Slider
                android:id="@+id/maxSlider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:stepSize="1"
                android:value="8"
                android:valueFrom="2"
                android:valueTo="8" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/privateSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Phòng riêng (ẩn khỏi danh sách, cần mã)" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/roomPasswordLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Mật khẩu phòng (tùy chọn)"
                android:visibility="gone">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/roomPasswordInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                    android:maxLength="32" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/ffSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sát thương đồng đội (Team Deathmatch)" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/jipSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Cho vào giữa trận (chỉ Free For All)" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            style="@style/Text.Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bản đồ" />

        <!-- map cards are added from Java -->
        <LinearLayout
            android:id="@+id/mapCards"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/createButton"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="8dp"
            android:text="@string/create_room"
            android:textSize="18sp" />
    </LinearLayout>
</LinearLayout>
